generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  password   String
  role       String    @default("PATIENT")
  crm        String?
  specialty  String?
  university String?
  semester   Int?
  createdAt  DateTime  @default(now())
  cases      Case[]    @relation("PatientCases")
  opinions   Case[]    @relation("DoctorCases")
  comments   Comment[]
}

model Case {
  id          String     @id @default(cuid())
  title       String
  description String
  specialty   String
  status      String     @default("PENDING")
  isPaid      Boolean    @default(false)
  amount      Float?
  patient     User       @relation("PatientCases", fields: [patientId], references: [id])
  patientId   String
  doctor      User?      @relation("DoctorCases", fields: [doctorId], references: [id])
  doctorId    String?
  documents   Document[]
  opinion     Opinion?
  comments    Comment[]
  createdAt   DateTime   @default(now())
  deadline    DateTime?
}

model Document {
  id        String   @id @default(cuid())
  filename  String
  path      String
  mimetype  String
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    String
  createdAt DateTime @default(now())
}

model Opinion {
  id        String   @id @default(cuid())
  content   String
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    String   @unique
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    String
  createdAt DateTime @default(now())
}
