# Database Configuration
# ⚠️ PRODUCTION (Vercel): Use PostgreSQL - SQLite does NOT persist
# ✅ LOCAL DEV: SQLite is fine for testing

# For Vercel Postgres (PostgreSQL):
DATABASE_URL="postgresql://user:password@host:5432/segundavoz"

# For local development with SQLite (optional):
# DATABASE_URL="file:./prisma/dev.db"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"  # Change to your Vercel domain in production: https://seu-app.vercel.app
NEXTAUTH_SECRET="your-random-secret-here"  # Generate: openssl rand -base64 32

# Stripe Payment (get from https://dashboard.stripe.com)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."  # Publishable key (visible to client)
STRIPE_SECRET_KEY="sk_test_..."  # Secret key (keep private)
STRIPE_WEBHOOK_SECRET="whsec_..."  # Webhook signing secret

# Email Configuration (Nodemailer - e.g., Gmail)
EMAIL_HOST="smtp.gmail.com"  # SMTP server
EMAIL_PORT="587"  # SMTP port
EMAIL_USER="seu-email@gmail.com"  # Email account
EMAIL_PASSWORD="sua-senha-de-app"  # Gmail app-specific password (not regular password)

# Optional: Upload Directory
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"  # 10MB

# Environment
NODE_ENV="development"  # Change to "production" on Vercel

